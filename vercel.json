{
    "framework": "vite",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
      {
        "source": "/stronglegs",
        "destination": "https://afl-stronglegs.vercel.app/stronglegs"
      },
      {
        "source": "/stronglegs/:path+",
        "destination": "https://afl-stronglegs.vercel.app/stronglegs/:path+"
      }
    ]
  }